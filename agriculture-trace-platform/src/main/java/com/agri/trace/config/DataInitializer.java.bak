    private void createProductWithBatch(String name, String category, String origin,
                                         String spec, BigDecimal price, String batchNo,
                                         String traceLevel, boolean addRecords) {
        Product p = new Product();
        p.setName(name);
        p.setCategory(category);
        p.setOrigin(origin);
        p.setSpec(spec);
        p.setPrice(price);
        p.setStock((int)(Math.random() * 500) + 100);
        p.setBatchNo(batchNo);
        p.setDescription(String.format("%s%s，全程溯源可查，品质保障。", origin, name));
        p.setTraceLevel(traceLevel);
        p.setStatus(1);
        p.setCreateTime(LocalDateTime.now());
        productMapper.insert(p);

        Batch b = new Batch();
        b.setBatchNo(batchNo);
        b.setProductId(p.getId());
        b.setProduceDate(LocalDate.now().minusMonths((long)(Math.random() * 6 + 1)));
        b.setHarvestDate(LocalDate.now().minusDays((long)(Math.random() * 15 + 1)));
        b.setQuantity((int)(Math.random() * 5000) + 500);
        b.setFarmAddress(origin + "市" + batchNo.substring(batchNo.length()-3) + "镇生产基地");
        b.setFarmArea((int)(Math.random() * 80 + 20) + "亩");
        String[] soilTypes = {"棕壤土", "红壤土", "黑土", "沙壤土", "黄壤土", "水稻土"};
        b.setSoilType(soilTypes[(int)(Math.random() * soilTypes.length)]);
        b.setCreateTime(LocalDateTime.now());
        batchMapper.insert(b);

        if (addRecords) {
            addTraceRecord(b.getId(), "种植", LocalDate.now().minusMonths(4).toString(), "完成种苗定植与基肥施用");
            addTraceRecord(b.getId(), "施肥", LocalDate.now().minusMonths(2).toString(), "施用有机肥500kg/亩");
            addTraceRecord(b.getId(), "灌溉", LocalDate.now().minusMonths(1).toString(), "智能滴灌系统灌溉");
            addTraceRecord(b.getId(), "采收", LocalDate.now().minusDays(5).toString(), "人工挑选采收，分级包装");
            addTraceRecord(b.getId(), "加工", LocalDate.now().minusDays(2).toString(), "清洗、分拣、称重、冷链包装");

            // 农残检测（全部达标）
            String[] items = {"毒死蜱", "多菌灵", "氯氰菊酯", "吡虫啉", "啶虫脒", "联苯菊酯", "哒螨灵", "三环唑"};
            // 随机选 3-4 项检测
            int count = (int)(Math.random() * 2) + 3;
            for (int i = 0; i < count; i++) {
                int idx = (int)(Math.random() * items.length);
                String result = Math.random() > 0.9 ? "0.02" : "未检出";
                addPesticideReport(b.getId(), items[idx], result, "0.05", "mg/kg", true);
            }
        }
    }private void insertKnowledgeDocs() {
        // GB 2763 法规知识
        KnowledgeDoc doc1 = new KnowledgeDoc();
        doc1.setTitle("GB 2763-2021 食品中农药最大残留限量");
        doc1.setCategory("法规");
        doc1.setContent("GB 2763-2021规定了食品中农药的最大残留限量。该标准适用于各类食品中农药残留的监督管理。主要限量包括：水果类：毒死蜱≤0.05mg/kg，多菌灵≤0.10mg/kg，氯氰菊酯≤0.20mg/kg；蔬菜类：毒死蜱≤0.05mg/kg，啶虫脒≤0.05mg/kg；粮食类：毒死蜱≤0.05mg/kg，三环唑≤0.10mg/kg；茶叶类：联苯菊酯≤0.01mg/kg，哒螨灵≤0.05mg/kg，氯氰菊酯≤0.02mg/kg。");
        knowledgeDocMapper.insert(doc1);

        KnowledgeDoc doc2 = new KnowledgeDoc();
        doc2.setTitle("GB 14881-2013 食品生产通用卫生规范");
        doc2.setCategory("法规");
        doc2.setContent("GB 14881-2013规定了食品生产过程中原料采购、加工、包装、贮存和运输等环节的场所、设施、人员的基本卫生要求和管理准则。适用于各类食品的生产，包括农产品的初加工和深加工。");
        knowledgeDocMapper.insert(doc2);

        KnowledgeDoc doc3 = new KnowledgeDoc();
        doc3.setTitle("NY/T 391-2013 绿色食品 产地环境质量");
        doc3.setCategory("标准");
        doc3.setContent("NY/T 391-2013标准规定了绿色食品产地的环境空气质量、农田灌溉水质、土壤环境质量等要求。适用于绿色食品（包括农产品）的产地环境评价。");
        knowledgeDocMapper.insert(doc3);

        KnowledgeDoc doc4 = new KnowledgeDoc();
        doc4.setTitle("农产品溯源管理规范");
        doc4.setCategory("规范");
        doc4.setContent("农产品溯源系统应记录从种植/养殖到销售的全链条信息，包括：农事操作记录（施肥、灌溉、喷药）、加工记录、检测报告、物流信息。每批次产品应有唯一溯源编码。溯源信息应至少保存2年。");
        knowledgeDocMapper.insert(doc4);

        KnowledgeDoc doc5 = new KnowledgeDoc();
        doc5.setTitle("山东红富士苹果种植技术规范");
        doc5.setCategory("规范");
        doc5.setContent("山东红富士苹果种植要点：选用优良品种，合理密植（每亩40-50株）。基肥以有机肥为主（每亩3-5吨），追肥以复合肥为主。病虫害防治以生物防治为主，化学防治为辅，严格遵守安全间隔期。适时采收，果实可溶性固形物含量达到14%以上方可采收。");
        knowledgeDocMapper.insert(doc5);

        log.info("知识库文档已创建（5条）");
    }
}

    private void addTraceRecord(Long batchId, String type, String date, String content) {
        TraceRecord record = new TraceRecord();
        record.setBatchId(batchId);
        record.setRecordType(type);
        record.setRecordTime(LocalDate.parse(date).atStartOfDay());
        record.setContent(content);
        record.setCreateTime(LocalDateTime.now());
        traceRecordMapper.insert(record);
    }

    private void addPesticideReport(Long batchId, String item, String result,
                                     String limit, String unit, boolean compliant) {
        PesticideReport report = new PesticideReport();
        report.setBatchId(batchId);
        report.setReportNo("REP-" + System.currentTimeMillis() + (int)(Math.random() * 1000));
        report.setTestDate(LocalDate.now());
        report.setTestOrganization("农业农村部农产品质量监督检验测试中心");
        report.setItemName(item);
        report.setResult(result);
        report.setStandardLimit(limit);
        report.setUnit(unit);
        report.setIsCompliant(compliant);
        report.setCreateTime(LocalDateTime.now());
        pesticideReportMapper.insert(report);
    
    private void addTraceRecord(Long batchId, String type, String date, String content) {
        TraceRecord record = new TraceRecord();
        record.setBatchId(batchId);
        record.setRecordType(type);
        record.setRecordTime(LocalDate.parse(date).atStartOfDay());
        record.setContent(content);
        record.setCreateTime(LocalDateTime.now());
        traceRecordMapper.insert(record);
    }

    private void addPesticideReport(Long batchId, String item, String result,
                                     String limit, String unit, boolean compliant) {
        PesticideReport report = new PesticideReport();
        report.setBatchId(batchId);
        report.setReportNo("REP-" + System.currentTimeMillis() + (int)(Math.random() * 1000));
        report.setTestDate(LocalDate.now());
        report.setTestOrganization("农业农村部农产品质量监督检验测试中心");
        report.setItemName(item);
        report.setResult(result);
        report.setStandardLimit(limit);
        report.setUnit(unit);
        report.setIsCompliant(compliant);
        report.setCreateTime(LocalDateTime.now());
        pesticideReportMapper.insert(report);
    }
}
